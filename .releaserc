{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    ["@semantic-release/changelog", {
      "changelogFile": "docs/CHANGELOG.md"
    }],
    ["@semantic-release/npm", { "npmPublish": false }],
    ["@semantic-release/exec", {
      "prepareCmd": "VITE_BASE_URL=/Trex-Http-Client/ pnpm run build && cd dist && zip -r ../trex-http-client-pwa.zip ./*"
    }],
    ["@semantic-release/git", {
      "assets": ["package.json", "docs/CHANGELOG.md", "docs/metrics-history.json", "docs/pr-history.json"],
      "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
    }],
    ["@semantic-release/github", {
      "assets": [
        {"path": "trex-http-client-pwa.zip", "label": "PWA Distribution"}
      ]
    }]
  ]
}
